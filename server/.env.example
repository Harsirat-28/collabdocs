# PostgreSQL connection string (Neon/Supabase/local)
DATABASE_URL="postgresql://user:password@host:5432/collabdocs?schema=public"

# Server
PORT=4000
CLIENT_ORIGIN="http://localhost:5173"

# Auth secrets - generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET="replace-me"
JWT_REFRESH_SECRET="replace-me"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=7

# Local image storage
UPLOAD_DIR="uploads"
MAX_UPLOAD_MB=5

# Rate limiting on /api/auth/login and /api/auth/signup
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
AUTH_RATE_LIMIT_MAX_ATTEMPTS=10
